---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  excerpt: string;
  date: Date;
  author: string;
  category: string;
  readTime?: string;
  image?: string;
}

const { title, excerpt, date, author, category, readTime, image } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
}).format(date);
---

<BaseLayout title={`${title} | Blog Agentes.AI`} description={excerpt} image={image}>
  <article class="blog-article-section">
    <div class="container prose-container">
      <!-- Back Navigation -->
      <a href="/#blog" class="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        <span>Volver a las publicaciones</span>
      </a>

      <!-- Header Meta -->
      <header class="article-header">
        <div class="article-tags">
          <span class="mono-badge purple">{category}</span>
          <span class="mono-badge cyan">{readTime}</span>
        </div>
        <h1 class="article-title">{title}</h1>
        <p class="article-excerpt">{excerpt}</p>
        
        <div class="article-author-bar">
          <div class="author-avatar">🤖</div>
          <div class="author-info">
            <span class="author-name">{author}</span>
            <span class="author-date">Publicado el {formattedDate}</span>
          </div>
        </div>
      </header>

      <!-- Featured Image -->
      {image && (
        <div class="featured-image-box">
          <img src={image} alt={title} class="featured-image" />
        </div>
      )}

      <!-- Article Main Body -->
      <div class="prose">
        <slot />
      </div>

      <!-- Post Article CTA Card -->
      <div class="article-cta-box tech-card">
        <div class="cta-badge mono-badge emerald">Transformación IA B2B</div>
        <h3>¿Quieres implementar un Agente IA como este en tu empresa?</h3>
        <p>Entrenamos modelos privados con tus manuales y documentos técnicos en menos de 48 horas.</p>
        <a href="/producto" class="btn-primary">
          <span>Ver Demostración y Producto</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .blog-article-section {
    padding: 3rem 0 6rem 0;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    margin-bottom: 2rem;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--accent-purple);
  }

  .article-header {
    margin-bottom: 2.5rem;
  }

  .article-tags {
    display: flex;
    gap: 10px;
    margin-bottom: 1.25rem;
  }

  .article-title {
    font-size: clamp(2rem, 4vw, 3.2rem);
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .article-excerpt {
    font-size: 1.2rem;
    color: #cbd5e1;
    line-height: 1.6;
    margin-bottom: 1.75rem;
  }

  .article-author-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-subtle);
  }

  .author-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(139, 92, 246, 0.15);
    border: 1px solid var(--border-glow);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
  }

  .author-name {
    display: block;
    font-weight: 600;
    font-size: 0.95rem;
    color: #ffffff;
  }

  .author-date {
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  .featured-image-box {
    margin-bottom: 3rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
  }

  .featured-image {
    width: 100%;
    max-height: 450px;
    object-fit: cover;
  }

  .article-cta-box {
    margin-top: 4rem;
    text-align: center;
    padding: 2.5rem;
    border-color: var(--border-glow);
    background: linear-gradient(180deg, var(--bg-card) 0%, rgba(139, 92, 246, 0.08) 100%);
  }

  .article-cta-box h3 {
    font-size: 1.5rem;
    margin-top: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .article-cta-box p {
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
  }
</style>
