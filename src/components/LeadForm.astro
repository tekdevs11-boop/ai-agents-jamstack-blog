---
interface Props {
  title?: string;
  subtitle?: string;
  buttonText?: string;
}

const { 
  title = "Solicita una Demostración de Agente IA B2B", 
  subtitle = "Recibe un prototipo funcional de agente entrenado con la documentación de tu empresa sin costo inicial.",
  buttonText = "Obtener Acceso a Demostración" 
} = Astro.props;
---

<div class="lead-form-card" id="lead-form">
  <div class="form-header">
    <div class="mono-badge emerald">100% Cero Costo JAMstack</div>
    <h3>{title}</h3>
    <p>{subtitle}</p>
  </div>

  <div id="form-success-message" style="display: none;" class="success-banner">
    <div class="success-icon">✅</div>
    <h4>¡Solicitud Enviada con Éxito!</h4>
    <p>Hemos recibido tus datos correctamente. Nuestro equipo se pondrá en contacto contigo a la brevedad para configurar tu Agente IA.</p>
  </div>

  <form 
    name="b2b-lead-capture" 
    method="POST" 
    data-netlify="true" 
    action="/producto?success=true" 
    class="form-body"
    id="b2b-form"
  >
    <!-- Hidden Netlify Forms field -->
    <input type="hidden" name="form-name" value="b2b-lead-capture" />

    <div class="form-group">
      <label for="selectedPlan">Plan Seleccionado</label>
      <select id="selectedPlan" name="selectedPlan" required>
        <option value="Starter (Gratis para siempre)">Starter — Gratis para siempre</option>
        <option value="Enterprise (USD 99 / mes)">Enterprise — USD 99 / mes</option>
        <option value="Solución Personalizada">Solución 100% Personalizada</option>
      </select>
    </div>

    <div class="form-group">
      <label for="fullName">Nombre y Apellido</label>
      <input type="text" id="fullName" name="fullName" placeholder="Ej. Alex Turner" required />
    </div>

    <div class="form-group">
      <label for="workEmail">Correo Corporativo</label>
      <input type="email" id="workEmail" name="workEmail" placeholder="alex@tuempresa.com" required />
    </div>

    <div class="form-group">
      <label for="phone">Teléfono / WhatsApp (Opcional)</label>
      <input type="tel" id="phone" name="phone" placeholder="+54 9 11 1234-5678" />
    </div>

    <div class="form-group">
      <label for="useCase">¿Qué proceso o necesidades deseas automatizar?</label>
      <textarea id="useCase" name="useCase" rows="3" placeholder="Ej. Atención al cliente B2B, integración con CRM, calificación de prospectos..."></textarea>
    </div>

    <button type="submit" class="btn-primary btn-full" id="submit-btn">
      <span>{buttonText}</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </button>

    <div class="form-privacy">
      🔒 Tus datos se tratan bajo estrictos estándares de privacidad. Cero spam.
    </div>
  </form>
</div>

<script>
  // Envío síncrono/AJAX a Netlify Forms con confirmación visual en pantalla
  const form = document.getElementById('b2b-form') as HTMLFormElement;
  const successBanner = document.getElementById('form-success-message');

  if (form && successBanner) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(form);

      fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(formData as any).toString(),
      })
        .then(() => {
          form.style.display = 'none';
          successBanner.style.display = 'block';
        })
        .catch((error) => {
          console.error('Error enviando formulario:', error);
          form.submit(); // Fallback directo
        });
    });
  }
</script>

<style>
  .lead-form-card {
    background: var(--bg-card);
    border: 1px solid var(--border-glow);
    border-radius: var(--radius-lg);
    padding: 2.25rem;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4);
    max-width: 580px;
    margin: 0 auto;
  }

  .form-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .form-header h3 {
    font-size: 1.6rem;
    margin-top: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .form-header p {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .form-body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-group label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-main);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
    color: #ffffff;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--accent-purple);
    box-shadow: 0 0 0 3px var(--accent-purple-glow);
  }

  .form-group select option {
    background: var(--bg-card);
    color: #ffffff;
  }

  .btn-full {
    width: 100%;
    margin-top: 0.5rem;
  }

  .form-privacy {
    text-align: center;
    font-size: 0.78rem;
    color: var(--text-dim);
    margin-top: 0.5rem;
  }

  .success-banner {
    text-align: center;
    padding: 2rem 1rem;
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: var(--radius-md);
  }

  .success-icon {
    font-size: 2.5rem;
    margin-bottom: 0.75rem;
  }

  .success-banner h4 {
    font-size: 1.35rem;
    color: var(--accent-emerald);
    margin-bottom: 0.5rem;
  }

  .success-banner p {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.5;
  }
</style>
