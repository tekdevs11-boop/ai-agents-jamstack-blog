---
interface Props {
  title: string;
  excerpt: string;
  date: Date;
  slug: string;
  category: string;
  readTime?: string;
  image?: string;
}

const { title, excerpt, date, slug, category, readTime = '4 min', image } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('es-ES', {
  day: 'numeric',
  month: 'short',
  year: 'numeric'
}).format(date);
---

<article class="tech-card blog-card">
  {image && (
    <div class="card-image-wrapper">
      <img src={image} alt={title} loading="lazy" class="card-image" />
      <div class="image-overlay"></div>
    </div>
  )}

  <div class="card-body">
    <div class="card-meta">
      <span class="mono-badge purple">{category}</span>
      <span class="meta-date">{formattedDate} • {readTime}</span>
    </div>

    <h3 class="card-title">
      <a href={`/blog/${slug}`}>{title}</a>
    </h3>

    <p class="card-excerpt">{excerpt}</p>

    <div class="card-footer">
      <a href={`/blog/${slug}`} class="read-more">
        <span>Leer Artículo</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</article>

<style>
  .blog-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 0;
  }

  .card-image-wrapper {
    position: relative;
    width: 100%;
    height: 190px;
    overflow: hidden;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .blog-card:hover .card-image {
    transform: scale(1.04);
  }

  .image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, var(--bg-card) 100%);
  }

  .card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.85rem;
    font-size: 0.8rem;
  }

  .meta-date {
    color: var(--text-dim);
    font-family: var(--font-mono);
  }

  .card-title {
    font-size: 1.2rem;
    margin-bottom: 0.65rem;
    color: #ffffff;
    line-height: 1.35;
  }

  .card-title a:hover {
    color: var(--accent-purple);
  }

  .card-excerpt {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin-bottom: 1.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-cyan);
  }

  .blog-card:hover .read-more {
    color: var(--accent-purple);
  }

  .read-more svg {
    transition: transform 0.2s ease;
  }

  .blog-card:hover .read-more svg {
    transform: translateX(4px);
  }
</style>
