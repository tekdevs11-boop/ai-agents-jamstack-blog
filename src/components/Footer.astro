---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-content">
    <div class="footer-brand">
      <div class="logo-text">AGENTES<span class="highlight">.AI</span></div>
      <p class="brand-desc">
        Infraestructura de Agentes de IA autónomos entrenados con tu conocimiento corporativo. Rendimiento extremo JAMstack con cero costos de por vida.
      </p>
      <div class="status-badge">
        <span class="pulse-dot"></span>
        <span class="status-text">Sistemas Operativos • 100% Cero Costo JAMstack</span>
      </div>
    </div>

    <div class="footer-links-grid">
      <div class="link-col">
        <h4>Navegación</h4>
        <a href="/">Inicio</a>
        <a href="/#blog">Blog & Recursos</a>
        <a href="/producto">Agentes B2B</a>
      </div>

      <div class="link-col">
        <h4>Administración</h4>
        <a href="/admin" target="_blank">Decap CMS (/admin)</a>
        <a href="https://github.com" target="_blank" rel="noopener">GitHub Repo</a>
        <a href="https://netlify.com" target="_blank" rel="noopener">Netlify Dashboard</a>
      </div>

      <div class="link-col">
        <h4>Tecnologías</h4>
        <span class="tech-tag">Astro 4.x</span>
        <span class="tech-tag">Decap CMS</span>
        <span class="tech-tag">Git Gateway</span>
        <span class="tech-tag">Tailwind/Vanilla CSS</span>
      </div>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {currentYear} Agentes.AI — Plataforma JAMstack Cero Costo de Por Vida.</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border-subtle);
    background: #06070a;
    padding-top: 4rem;
    padding-bottom: 2rem;
    margin-top: auto;
  }

  .footer-content {
    display: grid;
    grid-template-columns: 1.5fr 2fr;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .logo-text {
    font-size: 1.25rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 0.75rem;
  }

  .logo-text .highlight {
    color: var(--accent-purple);
  }

  .brand-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    max-width: 380px;
    margin-bottom: 1.25rem;
    line-height: 1.6;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.25);
    padding: 6px 12px;
    border-radius: 9999px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-emerald);
  }

  .footer-links-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .link-col h4 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .link-col a {
    display: block;
    font-size: 0.9rem;
    color: #cbd5e1;
    margin-bottom: 0.6rem;
  }

  .link-col a:hover {
    color: var(--accent-purple);
  }

  .tech-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-cyan);
    background: rgba(6, 182, 212, 0.08);
    border: 1px solid var(--border-cyan);
    padding: 3px 8px;
    border-radius: 4px;
    margin-bottom: 0.5rem;
    margin-right: 0.25rem;
  }

  .footer-bottom {
    border-top: 1px solid var(--border-subtle);
    padding-top: 1.5rem;
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-dim);
  }

  @media (max-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .footer-links-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
