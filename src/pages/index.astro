---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import AgentChatMockup from '../components/AgentChatMockup.astro';

// Fetch published blog posts ordered by date descending, max 3 on home page
const recentPosts = (await getCollection('blog', ({ data }) => {
  return data.draft !== true;
})).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
---

<BaseLayout title="Agentes.AI — Infraestructura de IA B2B y Blog JAMstack">
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container">
      <div class="hero-badge-wrapper">
        <span class="mono-badge purple">
          <span class="pulse-dot"></span>
          Agentes de IA Autónomos B2B
        </span>
      </div>

      <h1 class="hero-title">
        Automatiza la operación de tu empresa con <span class="text-gradient">Agentes de IA Personalizados</span>
      </h1>

      <p class="hero-subtitle">
        Construimos e integramos agentes entrenados directamente con tus manuales, PDFs e historias de clientes. Rendimiento extremo, SEO óptimo e infraestructura JAMstack a <strong>$0/mes de por vida</strong>.
      </p>

      <div class="hero-cta-group">
        <a href="/producto" class="btn-primary">
          <span>Explorar Agentes & Demo</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a href="/blog" class="btn-secondary">
          <span>Ver todo el Blog</span>
        </a>
      </div>

      <!-- Live Interactive Agent Preview -->
      <div class="hero-mockup-container">
        <AgentChatMockup />
      </div>
    </div>
  </section>

  <!-- Features Grid Section -->
  <section class="features-section">
    <div class="container">
      <div class="section-header">
        <span class="mono-badge cyan">¿Por qué Agentes.AI?</span>
        <h2>La evolución de la Inteligencia Artificial B2B</h2>
        <p>Una arquitectura diseñada para empresas que requieren alta seguridad, velocidad e independencia de costos recurrentes de servidores.</p>
      </div>

      <div class="features-grid">
        <div class="tech-card feature-card">
          <div class="feature-icon cyan">⚡</div>
          <h3>Cero Latencia & Velocidad Jamstack</h3>
          <p>Compilación estática nativa con HTML puro. Tiempos de carga de página en menos de 300ms para maximizar tu puntuación en Google Lighthouse.</p>
        </div>

        <div class="tech-card feature-card">
          <div class="feature-icon purple">🔒</div>
          <h3>Privacidad Estricta de Datos</h3>
          <p>Tus manuales corporativos y datos de clientes se almacenan en entornos aislados con protocolo RAG y nunca entrenan modelos públicos.</p>
        </div>

        <div class="tech-card feature-card">
          <div class="feature-icon emerald">💎</div>
          <h3>100% Cero Costo de Por Vida</h3>
          <p>Desplegado gratuitamente en Netlify o Vercel. Gestión visual de contenido desde la plataforma respaldada por repositorios de GitHub.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Blog Feed Section (Max 3 Posts) -->
  <section class="blog-feed-section" id="blog">
    <div class="container">
      <div class="section-header">
        <span class="mono-badge purple">Últimas Publicaciones</span>
        <h2>Insights de IA & Arquitectura de Software</h2>
        <p>Artículos destacados sobre automatización e inteligencia artificial empresarial.</p>
      </div>

      {recentPosts.length > 0 ? (
        <>
          <div class="blog-grid">
            {recentPosts.map((post) => (
              <BlogCard
                title={post.data.title}
                excerpt={post.data.excerpt}
                date={post.data.date}
                slug={post.slug}
                category={post.data.category}
                readTime={post.data.readTime}
                image={post.data.image}
              />
            ))}
          </div>
          <div class="view-all-wrapper">
            <a href="/blog" class="btn-secondary">
              <span>Ver todas las publicaciones del Blog ({recentPosts.length}+)</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </>
      ) : (
        <div class="tech-card empty-posts">
          <p>No hay publicaciones aún.</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Styles */
  .hero-section {
    padding: 5rem 0 4rem 0;
    text-align: center;
  }

  .hero-badge-wrapper {
    margin-bottom: 1.5rem;
  }

  .hero-title {
    max-width: 900px;
    margin: 0 auto 1.5rem auto;
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    max-width: 720px;
    margin: 0 auto 2.5rem auto;
    color: var(--text-muted);
    line-height: 1.65;
  }

  .hero-cta-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 4rem;
  }

  .hero-mockup-container {
    margin-top: 2rem;
  }

  /* Section Header */
  .section-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3.5rem auto;
  }

  .section-header h2 {
    margin-top: 0.75rem;
    margin-bottom: 0.75rem;
  }

  /* Features Grid */
  .features-section {
    padding: 6rem 0;
    border-top: 1px solid var(--border-subtle);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.75rem;
  }

  .feature-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .feature-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    margin-bottom: 1.25rem;
  }

  .feature-icon.cyan {
    background: rgba(6, 182, 212, 0.12);
    border: 1px solid var(--border-cyan);
  }

  .feature-icon.purple {
    background: rgba(139, 92, 246, 0.12);
    border: 1px solid var(--border-glow);
  }

  .feature-icon.emerald {
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .feature-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.6rem;
  }

  .feature-card p {
    font-size: 0.92rem;
    line-height: 1.6;
  }

  /* Blog Feed */
  .blog-feed-section {
    padding: 6rem 0;
    border-top: 1px solid var(--border-subtle);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }

  .view-all-wrapper {
    display: flex;
    justify-content: center;
    margin-top: 3rem;
  }

  .empty-posts {
    text-align: center;
    padding: 3rem;
  }
</style>
