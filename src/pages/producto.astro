---
import BaseLayout from '../layouts/BaseLayout.astro';
import AgentChatMockup from '../components/AgentChatMockup.astro';
import LeadForm from '../components/LeadForm.astro';
---

<BaseLayout 
  title="Agentes de IA Personalizados B2B | Producto Digital & Licencias"
  description="Despliega un agente de Inteligencia Artificial entrenado con tu base de conocimientos corporativa. Licencia permanente sin suscripciones obligatorias."
>
  <!-- Hero Landing Section -->
  <section class="landing-hero">
    <div class="container">
      <div class="hero-header-box">
        <span class="mono-badge emerald">🚀 Producto Digital B2B • Entrega Instantánea</span>
        <h1>Agente de IA Entrenable para <span class="text-gradient">Ventas y Soporte Enterprise</span></h1>
        <p class="landing-subtitle">
          Recibe un paquete completo con el código fuente, la infraestructura JAMstack y la plantilla RAG lista para conectar con tus PDFs y documentos internos.
        </p>
      </div>

      <div class="landing-grid">
        <div class="landing-left">
          <AgentChatMockup />
        </div>

        <div class="landing-right">
          <LeadForm 
            title="Consigue la Licencia del Agente" 
            subtitle="Recibe la guía de arquitectura, el template de código y el presupuesto para entrenamiento privado."
            buttonText="Descargar Paquete & Solicitar Demo"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Product Features Breakdown -->
  <section class="value-props-section">
    <div class="container">
      <div class="section-header">
        <span class="mono-badge purple">Lo que incluye el Producto</span>
        <h2>Todo lo necesario para desplegar tu Agente IA en 48 Horas</h2>
      </div>

      <div class="value-grid">
        <div class="tech-card prop-card">
          <div class="prop-badge">01</div>
          <h3>Motor RAG Pre-configurado</h3>
          <p>Conector optimizado para archivos PDF, Word, Swagger/OpenAPI y tablas SQL. Búsqueda semántica de alta precisión.</p>
        </div>

        <div class="tech-card prop-card">
          <div class="prop-badge">02</div>
          <h3>Web Widget + API GraphQL / REST</h3>
          <p>Componente listo para incrustar en cualquier web o sistema interno (React, Vue, Astro, HTML puro o WordPress).</p>
        </div>

        <div class="tech-card prop-card">
          <div class="prop-badge">03</div>
          <h3>Panel de Administración /admin</h3>
          <p>Interfaz intuitiva basada en Decap CMS para actualizar los prompts, instrucciones y documentos sin tocar código.</p>
        </div>

        <div class="tech-card prop-card">
          <div class="prop-badge">04</div>
          <h3>Infraestructura Cero Costo</h3>
          <p>Despliegue automatizado en Netlify con 100 GB de transferencia mensual gratuita. Sin servidores pagados 24/7.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Tiers Section -->
  <section class="pricing-section">
    <div class="container">
      <div class="section-header">
        <span class="mono-badge cyan">Licencias & Servicios</span>
        <h2>Opciones Transparentes Sin Sorpresas</h2>
        <p>Selecciona el nivel de implementación ideal para tu organización.</p>
      </div>

      <div class="pricing-grid">
        <!-- Tier 1 -->
        <div class="tech-card price-card">
          <div class="price-header">
            <span class="mono-badge">Starter Codekit</span>
            <div class="price">$199 <span class="period">/ pago único</span></div>
            <p>Ideal para desarrolladores y startups que desean desplegarlo por su cuenta.</p>
          </div>
          <ul class="price-features">
            <li>✓ Código fuente completo en Astro + Decap CMS</li>
            <li>✓ Plantilla de conexión RAG con OpenAI / Anthropic</li>
            <li>✓ Documentación paso a paso en español</li>
            <li>✓ Soporte vía GitHub Issues (30 días)</li>
          </ul>
          <a href="#lead-form" class="btn-secondary btn-full">Solicitar Starter</a>
        </div>

        <!-- Tier 2 (Highlighted) -->
        <div class="tech-card price-card featured">
          <div class="featured-tag">RECOMENDADO PARA EMPRESAS</div>
          <div class="price-header">
            <span class="mono-badge purple">Enterprise Managed Agent</span>
            <div class="price">$850 <span class="period">/ proyecto llave en mano</span></div>
            <p>Nos encargamos del entrenamiento completo y la integración en tu sistema.</p>
          </div>
          <ul class="price-features">
            <li>✓ <strong>Todo lo del plan Starter</strong></li>
            <li>✓ Indexación y limpiado de hasta 500 páginas de documentos</li>
            <li>✓ Customización visual con la identidad de tu marca</li>
            <li>✓ Configuración de dominios y seguridad Git Gateway</li>
            <li>✓ Capacitación de 2 horas para tu equipo</li>
          </ul>
          <a href="#lead-form" class="btn-primary btn-full">Agendar Proyecto Enterprise</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .landing-hero {
    padding: 4rem 0 5rem 0;
  }

  .hero-header-box {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 3.5rem auto;
  }

  .hero-header-box h1 {
    margin-top: 1rem;
    margin-bottom: 1rem;
  }

  .landing-subtitle {
    font-size: 1.15rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .landing-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .value-props-section {
    padding: 6rem 0;
    border-top: 1px solid var(--border-subtle);
    background: rgba(0, 0, 0, 0.2);
  }

  .value-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.75rem;
  }

  .prop-card {
    position: relative;
    padding-top: 2.25rem;
  }

  .prop-badge {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent-purple);
    background: rgba(139, 92, 246, 0.1);
    border: 1px solid var(--border-glow);
    padding: 2px 8px;
    border-radius: 4px;
    display: inline-block;
    margin-bottom: 1rem;
  }

  .prop-card h3 {
    font-size: 1.15rem;
    margin-bottom: 0.6rem;
  }

  .prop-card p {
    font-size: 0.9rem;
    line-height: 1.55;
  }

  /* Pricing */
  .pricing-section {
    padding: 6rem 0;
    border-top: 1px solid var(--border-subtle);
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .price-card {
    display: flex;
    flex-direction: column;
    padding: 2.25rem;
  }

  .price-card.featured {
    border-color: var(--accent-purple);
    box-shadow: 0 0 40px var(--accent-purple-glow);
    background: linear-gradient(180deg, var(--bg-card) 0%, rgba(139, 92, 246, 0.08) 100%);
    position: relative;
  }

  .featured-tag {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--accent-purple);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    padding: 3px 12px;
    border-radius: 9999px;
    letter-spacing: 0.08em;
  }

  .price-header {
    margin-bottom: 1.75rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .price {
    font-size: 2.6rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0.75rem 0 0.5rem 0;
  }

  .price .period {
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--text-muted);
  }

  .price-features {
    list-style: none;
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    font-size: 0.9rem;
    color: #cbd5e1;
  }

  .price-features li strong {
    color: var(--accent-purple);
  }

  .btn-full {
    margin-top: auto;
    width: 100%;
  }

  @media (max-width: 900px) {
    .landing-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
