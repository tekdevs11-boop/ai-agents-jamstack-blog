---
import BaseLayout from '../layouts/BaseLayout.astro';
import AgentChatMockup from '../components/AgentChatMockup.astro';
import LeadForm from '../components/LeadForm.astro';
---

<BaseLayout 
  title="Agentes de IA Personalizados B2B | Producto Digital & Licencias"
  description="Despliega un agente de Inteligencia Artificial entrenado con tu base de conocimientos corporativa. Licencia permanente sin suscripciones obligatorias."
>
  <!-- Hero Landing Section -->
  <section class="landing-hero">
    <div class="container">
      <div class="hero-header-box">
        <span class="mono-badge emerald">🚀 Producto Digital B2B • Entrega Instantánea</span>
        <h1>Agente de IA Entrenable para <span class="text-gradient">Ventas y Soporte Enterprise</span></h1>
        <p class="landing-subtitle">
          Recibe un paquete completo con el código fuente, la infraestructura JAMstack y la plantilla RAG lista para conectar con tus PDFs y documentos internos.
        </p>
      </div>

      <div class="landing-grid">
        <div class="landing-left">
          <AgentChatMockup />
        </div>

        <div class="landing-right">
          <LeadForm 
            title="Consigue la Licencia del Agente" 
            subtitle="Recibe la guía de arquitectura, el template de código y el presupuesto para entrenamiento privado."
            buttonText="Descargar Paquete & Solicitar Demo"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Product Features Breakdown -->
  <section class="value-props-section">
    <div class="container">
      <div class="section-header">
        <span class="mono-badge purple">Lo que incluye el Producto</span>
        <h2>Todo lo necesario para desplegar tu Agente IA en 48 Horas</h2>
      </div>

      <div class="value-grid">
        <div class="tech-card prop-card">
          <div class="prop-badge">01</div>
          <h3>Motor RAG Pre-configurado</h3>
          <p>Conector optimizado para archivos PDF, Word, Swagger/OpenAPI y tablas SQL. Búsqueda semántica de alta precisión.</p>
        </div>

        <div class="tech-card prop-card">
          <div class="prop-badge">02</div>
          <h3>Web Widget + API GraphQL / REST</h3>
          <p>Componente listo para incrustar en cualquier web o sistema interno (React, Vue, Astro, HTML puro o WordPress).</p>
        </div>

        <div class="tech-card prop-card">
          <div class="prop-badge">03</div>
          <h3>Panel de Administración /admin</h3>
          <p>Interfaz intuitiva basada en Decap CMS para actualizar los prompts, instrucciones y documentos sin tocar código.</p>
        </div>

        <div class="tech-card prop-card">
          <div class="prop-badge">04</div>
          <h3>Infraestructura Cero Costo</h3>
          <p>Despliegue automatizado en Netlify con 100 GB de transferencia mensual gratuita. Sin servidores pagados 24/7.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Tiers Section -->
  <section class="pricing-section" id="pricing">
    <div class="container">
      <div class="section-header">
        <span class="mono-badge cyan">Planes & Servicios</span>
        <h2>Tu Empleado Digital a la Medida de tu Empresa</h2>
        <p>Comienza sin riesgo o accede a un servicio de evolución y acompañamiento continuo.</p>
      </div>

      <div class="pricing-grid">
        <!-- Plan 1: Starter -->
        <div class="tech-card price-card">
          <div class="price-header">
            <span class="mono-badge">Starter</span>
            <div class="price">Gratis <span class="period">para siempre</span></div>
            <p>Todo lo necesario para comenzar con tu primer empleado digital.</p>
          </div>
          <ul class="price-features">
            <li>✅ Agente IA completamente funcional.</li>
            <li>✅ Instalación incluida.</li>
            <li>✅ Configuración inicial incluida.</li>
            <li>✅ Funcionamiento con API gratuita de Google Gemini.</li>
            <li>✅ Sin costo mensual.</li>
            <li>✅ Uso ilimitado dentro de los límites de la API gratuita.</li>
            <li>✅ Base lista para comenzar a trabajar.</li>
            <li>✅ Posibilidad de solicitar entrenamientos adicionales.</li>
            <li>✅ Posibilidad de solicitar nuevas funcionalidades.</li>
            <li>✅ Posibilidad de solicitar integraciones con otros sistemas.</li>
          </ul>
          <div class="price-note">
            ℹ️ <em>Los entrenamientos, personalizaciones y desarrollos solicitados posteriormente se presupuestan por separado.</em>
          </div>
          <a href="#lead-form" class="btn-secondary btn-full" data-plan="Starter">Comenzar gratis</a>
        </div>

        <!-- Plan 2: Enterprise -->
        <div class="tech-card price-card featured">
          <div class="featured-tag">MÁS ELEGIDO</div>
          <div class="price-header">
            <span class="mono-badge purple">Enterprise</span>
            <div class="price">USD 99 <span class="period">/ mes</span></div>
            <p>Tu empleado digital evoluciona junto con tu empresa.</p>
          </div>
          <ul class="price-features">
            <li>✅ <strong>Todo lo incluido en Starter.</strong></li>
            <li>✅ Entrenamiento continuo incluido mientras el plan esté activo.</li>
            <li>✅ Actualización permanente del conocimiento del agente.</li>
            <li>✅ Personalización completa con la identidad de la empresa.</li>
            <li>✅ Adaptación del tono de comunicación y lenguaje de marca.</li>
            <li>✅ Capacitación para el equipo de trabajo.</li>
            <li>✅ Optimización continua del rendimiento del agente.</li>
            <li>✅ Incorporación de nuevas funciones sin costo de desarrollo cuando correspondan al servicio.</li>
            <li>✅ Revisión periódica para detectar oportunidades de mejora.</li>
            <li>✅ Consultoría para identificar nuevos procesos automatizables.</li>
            <li>✅ Soporte prioritario.</li>
            <li>✅ Prioridad en nuevas solicitudes.</li>
            <li>✅ Acompañamiento permanente durante el crecimiento del negocio.</li>
          </ul>
          <a href="#lead-form" class="btn-primary btn-full" data-plan="Enterprise">Quiero Enterprise</a>
        </div>
      </div>

      <!-- Mensaje Inferior -->
      <div class="custom-solution-note">
        <p>¿Necesitás una solución completamente personalizada?</p>
        <p class="highlight-text">Contactanos y diseñaremos un agente de IA adaptado específicamente a tu empresa.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Autoseleccionar el plan al hacer clic en el botón correspondiente
  document.querySelectorAll('[data-plan]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const planName = btn.getAttribute('data-plan');
      const planSelect = document.getElementById('selectedPlan') as HTMLSelectElement;
      if (planSelect && planName) {
        if (planName === 'Starter') {
          planSelect.value = 'Starter (Gratis para siempre)';
        } else if (planName === 'Enterprise') {
          planSelect.value = 'Enterprise (USD 99 / mes)';
        }
      }
    });
  });
</script>

<style>
  .landing-hero {
    padding: 4rem 0 5rem 0;
  }

  .hero-header-box {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 3.5rem auto;
  }

  .hero-header-box h1 {
    margin-top: 1rem;
    margin-bottom: 1rem;
  }

  .landing-subtitle {
    font-size: 1.15rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .landing-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .value-props-section {
    padding: 6rem 0;
    border-top: 1px solid var(--border-subtle);
    background: rgba(0, 0, 0, 0.2);
  }

  .value-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.75rem;
  }

  .prop-card {
    position: relative;
    padding-top: 2.25rem;
  }

  .prop-badge {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent-purple);
    background: rgba(139, 92, 246, 0.1);
    border: 1px solid var(--border-glow);
    padding: 2px 8px;
    border-radius: 4px;
    display: inline-block;
    margin-bottom: 1rem;
  }

  .prop-card h3 {
    font-size: 1.15rem;
    margin-bottom: 0.6rem;
  }

  .prop-card p {
    font-size: 0.9rem;
    line-height: 1.55;
  }

  /* Pricing */
  .pricing-section {
    padding: 6rem 0;
    border-top: 1px solid var(--border-subtle);
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .price-card {
    display: flex;
    flex-direction: column;
    padding: 2.25rem;
  }

  .price-card.featured {
    border-color: var(--accent-purple);
    box-shadow: 0 0 40px var(--accent-purple-glow);
    background: linear-gradient(180deg, var(--bg-card) 0%, rgba(139, 92, 246, 0.08) 100%);
    position: relative;
  }

  .featured-tag {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--accent-purple);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    padding: 3px 12px;
    border-radius: 9999px;
    letter-spacing: 0.08em;
  }

  .price-header {
    margin-bottom: 1.75rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .price {
    font-size: 2.6rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0.75rem 0 0.5rem 0;
  }

  .price .period {
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--text-muted);
  }

  .price-features {
    list-style: none;
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    font-size: 0.9rem;
    color: #cbd5e1;
  }

  .price-features li strong {
    color: var(--accent-purple);
  }

  .btn-full {
    margin-top: auto;
    width: 100%;
  }

  .price-note {
    font-size: 0.78rem;
    color: var(--text-dim);
    margin-bottom: 1.5rem;
    line-height: 1.4;
  }

  .custom-solution-note {
    text-align: center;
    margin-top: 3.5rem;
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .custom-solution-note .highlight-text {
    color: #ffffff;
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .landing-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
